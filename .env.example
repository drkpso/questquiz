# QuestQuiz runtime (Railway / Docker / local).

# Process binding:
# PORT=8080                 # Railway injects this automatically
# HOST=0.0.0.0              # required on Railway (default in npm start)
# SKIP_BUILD=1              # set in Docker image (public/ already built)

# Local preview only:
# PORT=43123
# HOST=127.0.0.1

# --- Email verification (Resend) ---
# Without these, signup still works: the six-digit code is shown on screen (demo mode).
# With RESEND_API_KEY set on Railway, codes are emailed and hidden from the UI.
#
# 1. Create a free account at https://resend.com
# 2. Create an API key → paste as RESEND_API_KEY in Railway Variables
# 3. For production, verify your domain in Resend and set EMAIL_FROM to that domain
#    (Resend's onboarding@resend.dev only delivers to the account owner's address)
#
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=QuestQuiz <noreply@learnassessment.com>

# Optional: Railway CLI
# RAILWAY_TOKEN=

# QuestQuiz has no required runtime secrets.
# Production on Railway serves static files; accounts use browser localStorage.

# Local / Docker / Railway process binding:
# PORT=8080                 # Railway injects this automatically
# HOST=0.0.0.0              # required on Railway (default in npm start)
# SKIP_BUILD=1              # set in Docker image (public/ already built)

# Local preview only:
# PORT=43123
# HOST=127.0.0.1

# Optional: Railway CLI (not needed for dashboard deploy)
# RAILWAY_TOKEN=

# Future backend (not implemented — see docs/PRODUCTION.md):
# DATABASE_URL=
# SESSION_SECRET=
# SMS_API_KEY=
# EMAIL_API_KEY=
# STRIPE_SECRET_KEY=
